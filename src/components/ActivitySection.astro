---
const {
  id,
  title,
  eyebrow,
  text,
  imgSrc,
  imgAlt,
  imagePosition = 'right',
  level,
  formats,
} = Astro.props;
const textOverlapClass = imagePosition === 'right' ? 'lg:-mr-32' : 'lg:-ml-32';
---

<section id={id} class="scroll-mt-8 px-4 py-8 antialiased md:py-16">
  <div class="mx-auto grid max-w-screen-xl lg:grid-cols-12 lg:gap-8 xl:gap-16">
    <div
      class:list={[
        'relative z-0 lg:col-span-5 lg:mt-0 lg:h-[36rem]',
        { 'lg:order-2': imagePosition === 'right' },
      ]}
    >
      <img class="h-56 w-full object-cover sm:h-96 md:h-full" src={imgSrc} alt={imgAlt} />
    </div>
    <div
      class:list={[
        'relative z-10 me-auto place-self-center bg-[#D6CABF] p-6 md:p-8 lg:col-span-7 lg:p-16',
        textOverlapClass,
      ]}
    >
      <p
        class="mb-4 font-['Roboto_Slab'] text-sm font-medium uppercase tracking-[0.2em] text-[#37636b]"
      >
        {eyebrow}
      </p>
      <h2 class="mb-8 text-4xl font-bold leading-tight tracking-tight text-[#37636b] md:text-6xl">
        {title}
      </h2>
      <p class="mb-8 whitespace-pre-line leading-relaxed text-[#534532]">{text}</p>
      <div class="grid gap-6 border-t border-[#37636b]/30 pt-6 sm:grid-cols-2">
        <div>
          <h3 class="mb-2 font-['Roboto_Slab'] text-lg font-medium text-[#37636b]">Niveau</h3>
          <p class="text-[#534532]">{level}</p>
        </div>
        <div>
          <h3 class="mb-2 font-['Roboto_Slab'] text-lg font-medium text-[#37636b]">Formats</h3>
          <p class="text-[#534532]">{formats}</p>
        </div>
      </div>
    </div>
  </div>
</section>
