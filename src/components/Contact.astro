---
const contactDetails = [
  { label: 'EMAIL', value: 'contact@nextline.ch', href: 'mailto:contact@nextline.ch' },
  { label: 'PHONE', value: '+41 00 000 00 00', href: 'tel:+41000000000' },
  { label: 'ADDRESS', value: 'Suisse, Alpes', href: 'https://maps.google.com' },
  { label: 'WEBSITE', value: 'www.nextline.ch', href: 'https://nextline.ch' },
];
---

<section id="contact" class="scroll-mt-24 px-4 py-16 antialiased md:py-24">
  <div class="mx-auto flex max-w-screen-xl flex-col items-center lg:flex-row lg:items-center">
    <div class="relative z-20 flex justify-center lg:w-[42%] lg:shrink-0 lg:justify-start">
      <img
        class="aspect-square h-56 w-56 shrink-0 object-contain md:h-72 md:w-72 lg:h-[38rem] lg:w-[38rem]"
        src="/img/logo.png"
        alt="Logo Next Line"
      />
    </div>
    <div
      class="relative z-10 mt-[-2rem] w-full bg-[#D6CABF] p-6 md:mt-[-4rem] md:p-10 lg:-ml-32 lg:mt-0 lg:w-[66%] lg:p-32 lg:pl-48"
    >
      <p
        class="mb-4 font-['Roboto_Slab'] text-sm font-medium uppercase tracking-[0.2em] text-[#37636b]"
      >
        NEXT LINE
      </p>
      <h2
        class="mb-10 font-['Roboto_Slab'] text-4xl font-medium tracking-wide text-[#37636b] md:text-6xl"
      >
        CONTACT
      </h2>
      <div class="grid gap-x-8 gap-y-7 sm:grid-cols-2">
        {
          contactDetails.map((detail) => (
            <div>
              <h3 class="mb-2 font-['Roboto_Slab'] text-sm font-medium tracking-[0.16em] text-[#37636b]">
                {detail.label}
              </h3>
              <a
                class="text-lg text-[#534532] underline decoration-[#37636b]/40 underline-offset-4 transition hover:text-[#37636b]"
                href={detail.href}
              >
                {detail.value}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
