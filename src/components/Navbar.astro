<nav
  class="sticky top-0 z-50 border-b border-[#37636b]/20 bg-[#D6CABF]/95 px-4 py-3 backdrop-blur-md"
  aria-label="Navigation principale"
>
  <div class="mx-auto flex max-w-screen-xl items-center justify-between">
    <a href="#top" aria-label="Retour à l'accueil Next Line">
      <img class="h-12 w-12 object-contain" src="/img/logo.png" alt="Next Line" />
    </a>

    <div class="hidden items-center gap-8 md:flex">
      <a
        class="font-['Roboto_Slab'] text-sm uppercase tracking-[0.12em] text-[#534532] transition hover:text-[#37636b]"
        href="#activities"
      >
        Activités
      </a>
      <a
        class="font-['Roboto_Slab'] text-sm uppercase tracking-[0.12em] text-[#534532] transition hover:text-[#37636b]"
        href="#practical-info"
      >
        Infos pratiques
      </a>
      <a
        class="font-['Roboto_Slab'] text-sm uppercase tracking-[0.12em] text-[#534532] transition hover:text-[#37636b]"
        href="#team"
      >
        Notre team
      </a>
      <a
        class="bg-[#37636b] px-5 py-3 font-['Roboto_Slab'] text-sm uppercase tracking-[0.12em] text-[#D6CABF] transition hover:bg-[#534532]"
        href="#contact"
      >
        Contact
      </a>
    </div>

    <div class="relative md:hidden">
      <button
        type="button"
        class="flex h-11 w-11 flex-col items-center justify-center gap-1.5 border border-[#37636b] text-[#37636b]"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="block h-0.5 w-5 bg-current"></span>
        <span class="block h-0.5 w-5 bg-current"></span>
        <span class="block h-0.5 w-5 bg-current"></span>
      </button>
      <div
        id="mobile-menu"
        class="absolute right-0 top-14 hidden w-56 border border-[#37636b]/20 bg-[#D6CABF] p-4 shadow-lg"
        data-mobile-menu
      >
        <div
          class="grid gap-4 font-['Roboto_Slab'] text-sm uppercase tracking-[0.1em] text-[#534532]"
        >
          <a href="#activities">Activités</a>
          <a href="#team">Notre team</a>
          <a href="#practical-info">Infos pratiques</a>
          <a href="#contact">Contact</a>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  const menuToggle = document.querySelector('[data-menu-toggle]');
  const mobileMenu = document.querySelector('[data-mobile-menu]');

  if (menuToggle instanceof HTMLButtonElement && mobileMenu instanceof HTMLElement) {
    const menuLinks = mobileMenu.querySelectorAll('a');

    menuToggle.addEventListener('click', () => {
      const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
      menuToggle.setAttribute('aria-expanded', String(!isOpen));
      menuToggle.setAttribute('aria-label', isOpen ? 'Ouvrir le menu' : 'Fermer le menu');
      mobileMenu.classList.toggle('hidden', isOpen);
    });

    menuLinks.forEach((link) => {
      link.addEventListener('click', () => {
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.setAttribute('aria-label', 'Ouvrir le menu');
        mobileMenu.classList.add('hidden');
      });
    });
  }
</script>
