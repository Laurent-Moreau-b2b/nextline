---
const { title, text, imgSrc } = Astro.props;
---

<section class="relative bg-gray-900">
  <img src={imgSrc} alt="" class="block h-auto w-full" />
  <div class="absolute inset-0 flex items-center justify-center px-4">
    <div class="w-full -translate-y-60 text-center">
      <h1 class="mb-4 w-full whitespace-nowrap text-center font-extrabold leading-none">
        {title}
      </h1>
      <h2 class="mx-auto mb-6 max-w-2xl text-center font-light">
        {text}
      </h2>
    </div>
  </div>
</section>
